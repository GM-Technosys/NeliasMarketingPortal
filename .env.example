VITE_SITE_URL=https://nelias.app
VITE_LOGIN_URL=https://login.nelias.app
VITE_CONTACT_EMAIL=contact@nelias.app
VITE_CONTACT_PHONE=+225 05 64 05 90 60
VITE_WHATSAPP=+225 07 00 40 92 41
# Feature gates: set to true only when the real capability works
VITE_FEATURE_CONFIGURATOR=false
VITE_FEATURE_CHECKOUT=false
VITE_FEATURE_PRICING_PUBLIC=false
# V2 only. Keep false: Industry+ packs are not part of V1.
VITE_FEATURE_INDUSTRY_PLUS=false
# Set to false to hide the language switcher (French copy is a draft until Debass approves it)
VITE_FEATURE_FRENCH=true
# Keep true on staging so search engines do not index it
VITE_NOINDEX=true
# Public URL that accepts the lead form as JSON (POST). Leave empty to open the visitor's email app instead. Never put secrets here.
VITE_LEAD_ENDPOINT=
